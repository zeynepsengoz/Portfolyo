ADMIN_KEY=change-me
JWT_ISSUER=portfolyo
JWT_AUDIENCE=portfolyo-admin
JWT_SECRET=change-me-with-long-random-secret
JWT_EXPIRES_MINUTES=120

# Optional: persist ASP.NET DataProtection keys (prevents antiforgery cookie decrypt errors after restart/deploy)
DATA_PROTECTION_KEYS_PATH=/var/data/keys

# Preferred on Render
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional fallback for local/dev
DefaultConnection=Host=localhost;Port=5432;Database=portfolyodb;Username=postgres;Password=postgres;Ssl Mode=Disable

# One-time local SQL Server -> PostgreSQL migration
# When true, PostgreSQL target tables are cleared and copied from local SQL Server.
MIGRATE_LOCAL_TO_POSTGRES=false
LEGACY_SQLSERVER_CONNECTION=Server=localhost;Database=portfolyodb;Trusted_Connection=True;TrustServerCertificate=True

# Run app directly on local SQL Server (no PostgreSQL)
USE_SQLSERVER=false
SQLSERVER_CONNECTION=Server=localhost;Database=portfolyodb;Trusted_Connection=True;TrustServerCertificate=True

# Cloudinary image storage (recommended for persistent uploads on Render)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

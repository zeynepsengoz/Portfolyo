@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Şifre Yenile</title>
    <style>
        :root {
            --purple: #8b5cf6;
            --pink: #ec4899;
            --bg: #0b1020;
            --text: #eef1ff;
            --muted: rgba(238,241,255,.72);
            --line: rgba(255,255,255,.14);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            color: var(--text);
            font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial;
            background: radial-gradient(900px 520px at 10% 10%, rgba(139,92,246,.40), transparent 55%), radial-gradient(760px 460px at 90% 18%, rgba(236,72,153,.26), transparent 55%), var(--bg);
        }
        .card {
            width: min(520px, 100%);
            border: 1px solid var(--line);
            border-radius: 18px;
            background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,.05));
            padding: 22px;
        }
        h1 { margin: 0 0 8px; font-size: 24px; }
        p { margin: 0 0 16px; color: var(--muted); }
        .error {
            margin: 0 0 12px;
            padding: 10px 12px;
            border-radius: 12px;
            border: 1px solid rgba(236,72,153,.35);
            background: rgba(236,72,153,.12);
            color: #ffe1ee;
            font-size: 14px;
        }
        .field { margin-bottom: 12px; }
        label { display: block; margin-bottom: 6px; font-size: 13px; color: var(--muted); }
        input {
            width: 100%;
            border: 1px solid rgba(255,255,255,.16);
            border-radius: 12px;
            background: rgba(0,0,0,.2);
            color: var(--text);
            padding: 12px;
            outline: none;
        }
        input:focus {
            border-color: rgba(139,92,246,.7);
            box-shadow: 0 0 0 4px rgba(139,92,246,.16);
        }
        .btn {
            width: 100%;
            border: 0;
            border-radius: 12px;
            color: #fff;
            font-weight: 800;
            padding: 12px;
            cursor: pointer;
            background: linear-gradient(135deg, var(--purple), var(--pink));
        }
        .mini {
            margin-top: 12px;
            text-align: right;
            font-size: 13px;
        }
        .mini a {
            color: rgba(238,241,255,.9);
            text-decoration: none;
            border-bottom: 1px dashed rgba(238,241,255,.35);
        }
    </style>
</head>
<body>
    <section class="card">
        <h1>Şifre Yenile</h1>
        <p>Admin Key ile admin şifresini güncelle.</p>

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }

        <form method="post" action="/admin/auth/forgot-password">
            @Html.AntiForgeryToken()

            <div class="field">
                <label>Admin Key</label>
                <input name="adminKey" autocomplete="off" />
            </div>

            <div class="field">
                <label>Username</label>
                <input name="username" autocomplete="username" />
            </div>

            <div class="field">
                <label>Yeni Şifre</label>
                <input name="newPassword" type="password" autocomplete="new-password" />
            </div>

            <div class="field">
                <label>Yeni Şifre (Tekrar)</label>
                <input name="newPasswordConfirm" type="password" autocomplete="new-password" />
            </div>

            <button class="btn" type="submit">Şifreyi Güncelle</button>
        </form>

        <div class="mini">
            <a href="/admin/auth/login">Girişe dön</a>
        </div>
    </section>
</body>
</html>

@model List<Portfolyo.Data.ProjectsTable>

@{
    ViewData["Title"] = "Projelerim";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    bool IsWebCategory(string? categoryName)
    {
        if (string.IsNullOrWhiteSpace(categoryName))
        {
            return false;
        }

        var normalized = categoryName.Trim().ToLowerInvariant()
            .Replace("ı", "i")
            .Replace("ş", "s")
            .Replace("ğ", "g")
            .Replace("ü", "u")
            .Replace("ö", "o")
            .Replace("ç", "c");

        return normalized.Contains("web");
    }
}

<div class="p-6 bg-background-light min-h-screen">
    <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Projelerim</h1>
                <p class="text-sm text-slate-500 mt-1">Sıralama, görsel ve linkler dahil tüm proje alanlarını buradan yönetebilirsin.</p>
            </div>

            <a href="/Projects/ProjectCreate"
               class="inline-flex items-center gap-2 rounded-full bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-sm font-semibold text-white shadow-md transition">
                <span class="material-symbols-outlined text-base">add</span>
                Yeni Proje Ekle
            </a>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <table class="w-full table-fixed text-left">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="w-[8%] px-4 py-4 text-xs font-semibold text-slate-500 uppercase">Sıra</th>
                        <th class="w-[14%] px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Proje Adı</th>
                        <th class="w-[16%] px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Başlık</th>
                        <th class="w-[16%] px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Açıklama</th>
                        <th class="w-[14%] px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Proje Linki</th>
                        <th class="w-[8%] px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Kart Görseli</th>
                        <th class="w-[8%] px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Galeri</th>
                        <th class="w-[8%] px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Kategori</th>
                        <th class="w-[18%] px-6 py-4 text-xs font-semibold text-slate-500 uppercase text-right">İşlemler</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-blue-50/40 transition">
                            <td class="px-4 py-4 text-sm text-slate-500">
                                <div class="flex items-center gap-2">
                                    <span class="min-w-[24px] text-center font-semibold">@item.DisplayOrder</span>
                                    <div class="flex flex-col gap-1">
                                        <form method="post" action="/Projects/MoveUp/@item.ProjectId">
                                            <button class="text-xs px-2 py-1 rounded bg-slate-100 hover:bg-slate-200" type="submit">↑</button>
                                        </form>
                                        <form method="post" action="/Projects/MoveDown/@item.ProjectId">
                                            <button class="text-xs px-2 py-1 rounded bg-slate-100 hover:bg-slate-200" type="submit">↓</button>
                                        </form>
                                    </div>
                                </div>
                            </td>

                            <td class="px-6 py-4 text-sm font-semibold text-slate-800">@item.ProjectName</td>
                            <td class="px-6 py-4 text-sm text-slate-600">@item.Title</td>
                            <td class="px-6 py-4 text-sm text-slate-600 truncate" title="@item.Description">@item.Description</td>

                            <td class="px-6 py-4 text-sm text-slate-600 truncate" title="@item.GithubUrl">
                                @if (!string.IsNullOrWhiteSpace(item.GithubUrl))
                                {
                                    <a href="@item.GithubUrl" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
                                        <i class="@(IsWebCategory(item.Category?.CategoryName) ? "fab fa-github" : "fab fa-itch-io") mr-1"></i>
                                        @item.GithubUrl
                                    </a>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400 italic">Yok</span>
                                }
                            </td>

                            <td class="px-6 py-4">
                                @if (!string.IsNullOrWhiteSpace(item.Image))
                                {
                                    <img src="@item.Image" class="w-20 h-12 object-cover rounded-lg border border-slate-200" />
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400 italic">Yok</span>
                                }
                            </td>

                            <td class="px-6 py-4 text-sm text-slate-600">
                                @(item.ProjectImages?.Count ?? 0) görsel
                            </td>

                            <td class="px-6 py-4">
                                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-600">@item.Category?.CategoryName</span>
                            </td>

                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2 whitespace-nowrap">
                                    <a href="/Projects/ProjectUpdate/@item.ProjectId"
                                       class="inline-flex items-center gap-1 rounded-full bg-amber-50 text-amber-600 px-4 py-1.5 text-xs font-medium hover:bg-amber-100 transition">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                        Düzenle
                                    </a>

                                    <a href="/Projects/ProjectDelete/@item.ProjectId"
                                       onclick="return confirm('Silmek istediğine emin misin?')"
                                       class="inline-flex items-center gap-1 rounded-full bg-red-50 text-red-600 px-4 py-1.5 text-xs font-medium hover:bg-red-100 transition">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                        Sil
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model Portfolyo.Data.ProjectsTable

@{
    ViewData["Title"] = "ProjectUpdate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="min-h-screen bg-white flex items-center justify-center px-4">

    <div class="w-full max-w-xl bg-white rounded-2xl shadow-md border border-slate-200 p-8">

        <!-- BAŞLIK -->
        <h1 class="text-2xl font-bold text-slate-900 mb-1">
            Projeyi Düzenle
        </h1>
        <p class="text-slate-500 mb-4">
            Mevcut proje bilgilerini güncelleyebilirsin.
        </p>

        <a asp-action="Index"
           asp-controller="Projects"
           class="text-indigo-600 text-sm font-medium inline-block mb-6">
            ← Projelere Dön
        </a>

        <!-- FORM -->
        <form asp-action="ProjectUpdate" method="post" class="space-y-5">

            <!-- ID (GİZLİ) -->
            <input type="hidden" asp-for="ProjectId" />

            <!-- PROJE ADI -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">
                    Proje Adı
                </label>
                <input asp-for="ProjectName"
                       class="w-full rounded-full border border-slate-300 px-4 py-2 text-slate-900
                              focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>

            <!-- BAŞLIK -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">
                    Proje Başlığı
                </label>
                <input asp-for="Title"
                       class="w-full rounded-full border border-slate-300 px-4 py-2 text-slate-900
                              focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>

            <!-- GÖRSEL -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">
                    Proje Görseli (URL)
                </label>
                <input asp-for="Image"
                       class="w-full rounded-full border border-slate-300 px-4 py-2 text-slate-900
                              focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>

            <!-- KATEGORİ -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">
                    Proje Kategorisi
                </label>
                <select asp-for="CategoryId"
                        asp-items="ViewBag.Category"
                        class="w-full rounded-full border border-slate-300 px-4 py-2 text-slate-900
                               focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    <option value="">Kategori Seçiniz</option>
                </select>
            </div>

            <!-- BUTONLAR -->
            <div class="flex justify-end gap-3 pt-4 border-t">
                <a asp-action="Index"
                   class="px-5 py-2 rounded-full bg-slate-100 text-slate-700 font-medium">
                    Vazgeç
                </a>

                <button type="submit"
                        class="inline-flex items-center justify-center
               rounded-full bg-blue-600 hover:bg-blue-700
               px-6 py-2 text-sm font-semibold text-white
               shadow-md transition">
                    Kaydet
                </button>

            </div>

        </form>

    </div>
</div>

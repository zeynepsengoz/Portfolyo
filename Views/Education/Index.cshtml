@model List<EducationTable>

@{
    ViewData["Title"] = "Education";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="p-6 bg-background-light min-h-screen">
    <div class="max-w-6xl mx-auto">

        <!-- HEADER -->
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">
                    Eğitim Bilgileri
                </h1>
                <p class="text-sm text-slate-500 mt-1">
                    Akademik geçmişini buradan yönetebilirsin.
                </p>
            </div>

            <!-- YENİ EĞİTİM EKLE -->
            <a href="/Education/Create"
               class="inline-flex items-center gap-2 rounded-full
                      bg-blue-600 hover:bg-blue-700
                      px-5 py-2.5 text-sm font-semibold text-white
                      shadow-md transition">
                <span class="material-symbols-outlined text-base">add</span>
                Yeni Eğitim
            </a>
        </div>

        <!-- TABLE CARD -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">

            <table class="w-full text-left">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Okul</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Bölüm</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Sınıf</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Yıllar</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Durum</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase text-right">İşlemler</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="hover:bg-blue-50/40 transition">

                                <td class="px-6 py-4 text-sm font-semibold text-slate-800">
                                    @item.SchoolName
                                </td>

                                <td class="px-6 py-4 text-sm text-slate-700">
                                    @item.Department
                                </td>

                                <td class="px-6 py-4 text-sm text-slate-600">
                                    @item.ClassLevel
                                </td>

                                <td class="px-6 py-4 text-sm text-slate-600">
                                    @item.StartYear -
                                    @(item.IsCurrent ? "Devam Ediyor" : item.EndYear?.ToString())
                                </td>

                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center rounded-full
                                                @(item.IsCurrent
                                                                                                ? "bg-green-50 text-green-600"
                                                                                                : "bg-slate-100 text-slate-500")
                                        px-3 py-1 text-xs font-semibold">
                                @(item.IsCurrent ? "Devam Ediyor" : "Tamamlandı")
                            </span>
                        </td>

                                <!-- ACTIONS -->
                                <td class="px-6 py-4 text-right">
                                    <div class="flex justify-end gap-2">

                                        <!-- EDIT -->
                                        <a href="/Education/UpdateEducation/@item.EducationId"
                                           class="inline-flex items-center gap-1 rounded-full
                                                          bg-amber-50 text-amber-600
                                                          px-4 py-1.5 text-xs font-medium
                                                          hover:bg-amber-100 transition">
                                            <span class="material-symbols-outlined text-sm">edit</span>
                                            Düzenle
                                        </a>

                                        <!-- DELETE -->
                                        <a href="/Education/DeleteEducation/@item.EducationId"
                                           onclick="return confirm('Silmek istediğine emin misin?')"
                                           class="inline-flex items-center gap-1 rounded-full
                                                          bg-red-50 text-red-600
                                                          px-4 py-1.5 text-xs font-medium
                                                          hover:bg-red-100 transition">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                            Sil
                                        </a>

                                    </div>
                                </td>
                            </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-slate-500 text-sm">
                                Henüz eklenmiş bir eğitim bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

@model List<EducationTable>

@{
    ViewData["Title"] = "Education";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="p-6 bg-background-light min-h-screen">
    <div class="max-w-6xl mx-auto">

        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Education</h1>
                <p class="text-sm text-slate-500 mt-1">Manage your academic background from here.</p>
            </div>

            <a href="/Education/Create"
               class="inline-flex items-center gap-2 rounded-full bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-sm font-semibold text-white shadow-md transition">
                <span class="material-symbols-outlined text-base">add</span>
                Add Education
            </a>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">School</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Department</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Class Level</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Years</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Status</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase text-right">Actions</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="hover:bg-blue-50/40 transition">
                                <td class="px-6 py-4 text-sm font-semibold text-slate-800">@item.SchoolName</td>
                                <td class="px-6 py-4 text-sm text-slate-700">@item.Department</td>
                                <td class="px-6 py-4 text-sm text-slate-600">@item.ClassLevel</td>
                                <td class="px-6 py-4 text-sm text-slate-600">@item.StartYear - @(item.IsCurrent ? "Ongoing" : item.EndYear?.ToString())</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center rounded-full @(item.IsCurrent ? "bg-green-50 text-green-600" : "bg-slate-100 text-slate-500") px-3 py-1 text-xs font-semibold">
                                        @(item.IsCurrent ? "Ongoing" : "Completed")
                                    </span>
                                </td>

                                <td class="px-6 py-4 text-right">
                                    <div class="flex justify-end gap-2">
                                        <a href="/Education/UpdateEducation/@item.EducationId"
                                           class="inline-flex items-center gap-1 rounded-full bg-amber-50 text-amber-600 px-4 py-1.5 text-xs font-medium hover:bg-amber-100 transition">
                                            <span class="material-symbols-outlined text-sm">edit</span>
                                            Edit
                                        </a>

                                        <a href="/Education/DeleteEducation/@item.EducationId"
                                           onclick="return confirm('Are you sure you want to delete this record?')"
                                           class="inline-flex items-center gap-1 rounded-full bg-red-50 text-red-600 px-4 py-1.5 text-xs font-medium hover:bg-red-100 transition">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-slate-500 text-sm">No education records added yet.</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

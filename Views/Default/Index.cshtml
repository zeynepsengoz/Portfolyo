@model List<Portfolyo.Data.ProjectsTable>

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Layout/Index.cshtml";

    string Slugify(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        text = text.Trim().ToLowerInvariant();

        text = text.Replace("ı", "i")
                   .Replace("ş", "s")
                   .Replace("ğ", "g")
                   .Replace("ü", "u")
                   .Replace("ö", "o")
                   .Replace("ç", "c");

        text = text.Replace(" ", "")
                   .Replace("-", "")
                   .Replace(".", "")
                   .Replace("/", "")
                   .Replace("&", "")
                   .Replace("(", "")
                   .Replace(")", "");

        return text;
    }

    string DisplayCategoryName(string? categoryName)
    {
        var slug = Slugify(categoryName ?? string.Empty);
        return slug switch
        {
            "oyun" => "Game",
            "web" => "Web",
            "blender" => "Blender",
            "pixelart" => "Pixel Art",
            "characterdesign" => "Character Design",
            _ => categoryName ?? string.Empty
        };
    }

    bool IsWebCategory(string? categoryName)
    {
        var slug = Slugify(categoryName ?? string.Empty);
        return slug.Contains("web");
    }

    string ExternalLinkLabel(string? categoryName) => IsWebCategory(categoryName) ? "GitHub" : "itch.io";
    string ExternalLinkIcon(string? categoryName) => IsWebCategory(categoryName) ? "fab fa-github" : "fab fa-itch-io";
}

@await Component.InvokeAsync("Home")
@await Component.InvokeAsync("About")
@await Component.InvokeAsync("Skill")

<section id="portfolio" class="portfolio-section">
    <div class="container">

        <div class="row mb-4">
            <div class="col-lg-10 col-xl-8 mx-lg-auto text-center">
                <div class="section-title h2 mb-3">
                    <h2 class="mb-0">Portfolio</h2>
                </div>

                <nav class="portfolio-filter">
                    <ul class="justify-content-center">
                        <li>
                            <a href="#portfolio" class="active" data-filter="all">
                                <i class="fas fa-border-all me-1"></i> All
                            </a>
                        </li>

                        @{
                            var categories = Model
                                .Select(x => x.Category?.CategoryName)
                                .Where(x => !string.IsNullOrWhiteSpace(x))
                                .Select(x => x!)
                                .Distinct()
                                .ToList();

                            if (!categories.Any(x => Slugify(x) == "characterdesign"))
                            {
                                categories.Add("Character Design");
                            }
                        }

                        @foreach (var cat in categories)
                        {
                            var slug = Slugify(cat);
                            <li>
                                <a href="#portfolio" data-filter="@slug">@DisplayCategoryName(cat)</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>

        <div class="portfolio-grid">
            @foreach (var item in Model)
            {
                var imgPath = string.IsNullOrEmpty(item.Image)
                    ? "/images/portfolio/placeholder.png"
                    : item.Image;

                var catSlug = Slugify(item.Category?.CategoryName ?? "");

                <article class="portfolio-card @catSlug" data-category="@catSlug">
                    <a href="/Portfolio/Detail/@item.ProjectId" class="portfolio-main-link">
                        <div class="portfolio-image">
                            <img src="@imgPath" alt="@item.ProjectName" />
                        </div>

                        <div class="portfolio-body">
                            <h4>@item.ProjectName</h4>
                            <p>@(string.IsNullOrWhiteSpace(item.Description) ? item.Title : item.Description) • @DisplayCategoryName(item.Category?.CategoryName)</p>
                        </div>
                    </a>

                    @if (!string.IsNullOrWhiteSpace(item.GithubUrl))
                    {
                        <a href="@item.GithubUrl" target="_blank" rel="noopener noreferrer" class="portfolio-ext-link">
                            <i class="@ExternalLinkIcon(item.Category?.CategoryName)"></i>
                            @ExternalLinkLabel(item.Category?.CategoryName)
                        </a>
                    }
                </article>
            }
        </div>

        <div id="portfolio-pagination" class="portfolio-pagination mt-4"></div>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
              const links = document.querySelectorAll(".portfolio-filter a[data-filter]");
              const items = document.querySelectorAll(".portfolio-grid .portfolio-card");
              const pager = document.getElementById("portfolio-pagination");
              const perPage = 6;
              let currentFilter = "all";
              let currentPage = 1;

              function getFilteredItems() {
                return Array.from(items).filter(item => {
                  if (currentFilter === "all") return true;
                  const itemCategory = ((item.getAttribute("data-category")) || "").toLowerCase();
                  return itemCategory === currentFilter;
                });
              }

              function renderPagination(totalPages) {
                if (!pager) return;
                pager.innerHTML = "";
                if (totalPages <= 1) return;

                for (let i = 1; i <= totalPages; i++) {
                  const btn = document.createElement("button");
                  btn.type = "button";
                  btn.textContent = i.toString();
                  btn.className = "portfolio-page-btn" + (i === currentPage ? " active" : "");
                  btn.addEventListener("click", function () {
                    currentPage = i;
                    applyFilterAndPagination();
                    const portfolioSection = document.getElementById("portfolio");
                    if (portfolioSection) {
                      portfolioSection.scrollIntoView({ behavior: "smooth", block: "start" });
                    }
                  });
                  pager.appendChild(btn);
                }
              }

              function applyFilterAndPagination() {
                const filtered = getFilteredItems();
                const totalPages = Math.max(1, Math.ceil(filtered.length / perPage));
                if (currentPage > totalPages) {
                  currentPage = 1;
                }

                items.forEach(item => {
                  item.hidden = true;
                });

                const start = (currentPage - 1) * perPage;
                const pageItems = filtered.slice(start, start + perPage);
                pageItems.forEach(item => {
                  item.hidden = false;
                });

                renderPagination(totalPages);
              }

              links.forEach(link => {
                link.addEventListener("click", function (e) {
                  e.preventDefault();
                  links.forEach(x => x.classList.remove("active"));
                  this.classList.add("active");

                  currentFilter = (this.getAttribute("data-filter") || "").toLowerCase();
                  currentPage = 1;
                  applyFilterAndPagination();
                });
              });

              applyFilterAndPagination();
            });
        </script>

    </div>
</section>

<section id="contact">

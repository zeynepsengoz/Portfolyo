


  
@model List<Portfolyo.Data.ProjectsTable>

@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "~/Views/Layout/Index.cshtml";

    string Slugify(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        text = text.Trim().ToLowerInvariant();

        text = text.Replace("ı", "i")
                   .Replace("ş", "s")
                   .Replace("ğ", "g")
                   .Replace("ü", "u")
                   .Replace("ö", "o")
                   .Replace("ç", "c");

        text = text.Replace(" ", "")
                   .Replace("-", "")
                   .Replace(".", "")
                   .Replace("/", "")
                   .Replace("&", "")
                   .Replace("(", "")
                   .Replace(")", "");

        return text;
    }
}

@await Component.InvokeAsync("Home")
@await Component.InvokeAsync("About")
@await Component.InvokeAsync("Skill")


<section id="portfolio" class="portfolio-section">

    <div class="container">

        <!-- BAŞLIK -->
        <div class="row mb-4">
            <div class="col-lg-10 col-xl-8 mx-lg-auto text-center">
                <div class="section-title h2 mb-3">
                    <h2 class="mb-0">Portfolyo</h2>
                    
                </div>

                <!-- FİLTRELER -->
                <nav class="portfolio-filter isotope-filter">
                    <ul class="justify-content-center">

                        <li>
                            <a href="#" class="active" data-filter="all">
                                <i class="fas fa-border-all me-1"></i> Tümü
                            </a>
                        </li>

                        @{
                            // Kategorileri tekilleştir
                            var categories = Model
                            .Select(x => x.Category?.CategoryName)
                            .Where(x => !string.IsNullOrWhiteSpace(x))
                            .Distinct()
                            .ToList();
                        }

                        @foreach (var cat in categories)
                        {
                            var slug = Slugify(cat);
                            <li>
                                <a href="#" data-filter="@slug">@cat</a>
                            </li>
                        }

                    </ul>
                </nav>
            </div>
        </div>

        

        <!-- KARTLAR -->
        <div class="portfolio-grid isotope-container">

            @foreach (var item in Model)
            {
                var imgPath = string.IsNullOrEmpty(item.Image)
                ? "/images/portfolio/placeholder.png"
                : item.Image;

                var catSlug = Slugify(item.Category?.CategoryName ?? "");

                <a href="/Portfolio/Detail/@item.ProjectId"
                   class="portfolio-card isotope-item @catSlug"
                   data-category="@catSlug">

                    <!-- ÜST: RESİM -->
                    <div class="portfolio-image">
                        <img src="@imgPath" alt="@item.ProjectName" />
                    </div>

                    <!-- ALT: YAZI -->
                    <div class="portfolio-body">
                        <h4>@item.ProjectName</h4>
                        <p>@item.Title • @item.Category?.CategoryName</p>
                    </div>

                </a>
            }
        </div>


        <script>
            document.addEventListener("DOMContentLoaded", function () {
              const links = document.querySelectorAll(".portfolio-filter a[data-filter]");
              const items = document.querySelectorAll(".portfolio-grid .portfolio-card");

              links.forEach(link => {
                link.addEventListener("click", function (e) {
                  e.preventDefault();

                  // aktif class
                  links.forEach(x => x.classList.remove("active"));
                  this.classList.add("active");

                  const filter = (this.getAttribute("data-filter") || "").toLowerCase();

                  items.forEach(item => {
                    if (filter === "all") {
                      item.style.display = "";
                      return;
                    }

                    const itemCategory = ((item.getAttribute("data-category")) || "").toLowerCase();
                    item.style.display = itemCategory === filter ? "" : "none";
                  });
                });
              });
            });
        </script>






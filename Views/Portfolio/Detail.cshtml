@using Portfolyo.Data
@model ProjectsTable

<div class="portfolio-detail-page">

    <!-- GERİ DÖN -->
    <a href="/Default/Index" class="back-link">
        ← Portfolyoya Dön
    </a>

    <!-- ANA DÜZEN -->
    <div class="detail-layout">

        <!-- SOL: YAZI -->
        <div class="detail-info">

            <h1>@Model.ProjectName</h1>

            <span class="detail-meta">
                @Model.Title • @Model.Category?.CategoryName
            </span>

            <!-- AÇIKLAMA -->
            <p class="detail-desc">
                @if (Model.ProjectId == 2)
                {
                    <text>
                        Unity ile geliştirilen bu 2D platform oyununda oyuncu, karakteri kontrol ederek
                        engelleri aşar ve bölüm hedeflerine ulaşmaya çalışır.
                    </text>
                }
                else if (Model.ProjectId == 3)
                {
                    <text>
                        Blender kullanılarak oluşturulan 3D ortam ve sahne çalışmaları.
                        Işıklandırma, kompozisyon ve atmosfer odaklı renderlar içerir.
                    </text>
                }
                else if (Model.ProjectId == 5)
                {
                    <text>
                        Aseprite ile hazırlanan pixel art çalışmaları.
                        Oyun içi karakter, obje ve ikon tasarımlarından oluşur.
                    </text>
                }
                else if (Model.ProjectId == 6)
                {
                    <text>
                        ASP.NET Core ile geliştirilen kişisel portfolyo web sitesi.
                        Admin panel ve proje detay sayfaları içerir.
                    </text>
                }
                else
                {
                    @Model.Description
                }
            </p>

            <!-- YAPILANLAR -->
            <div class="detail-section">
                <h3>Bu Projede Neler Yaptım?</h3>
                <ul>
                    @if (Model.ProjectId == 2)
                    {
                        <li>2D platform mekaniği ve karakter kontrol sistemi geliştirildi</li>
                        <li>Çarpışma ve etkileşim sistemi kuruldu</li>
                        <li>Toplanabilir objeler ve skor sistemi eklendi</li>
                    }
                    else if (Model.ProjectId == 3)
                    {
                        <li>3D ortam ve sahne modellemeleri yapıldı</li>
                        <li>Işıklandırma ve atmosfer çalışmaları gerçekleştirildi</li>
                        <li>Kamera açıları ve render ayarları düzenlendi</li>
                    }
                    else if (Model.ProjectId == 5)
                    {
                        <li>Aseprite ile pixel art karakter ve obje tasarımları yapıldı</li>
                        <li>Renk paleti ve stil bütünlüğü oluşturuldu</li>
                        <li>Oyun içi sprite ve ikonlar üretildi</li>
                    }
                    else if (Model.ProjectId == 6)
                    {
                        <li>ASP.NET Core MVC mimarisi kuruldu</li>
                        <li>Admin panel (ekle–düzenle–sil) geliştirildi</li>
                        <li>Responsive portfolyo ve detay sayfaları tasarlandı</li>
                    }
                </ul>
            </div>

        </div>

        <!-- SAĞ: GÖRSELLER -->
        <div class="detail-image">

            <!-- ANA GÖRSEL (PIXEL ART HARİÇ) -->
            @if (Model.ProjectId != 5)
            {
                <img src="@(Model.ProjectId == 2 ? "/images/portfolio/game-2d.png" :
                                Model.ProjectId == 3 ? "/images/portfolio/blender.jpg" :
                                "/images/portfolio/placeholder.png")"
                 alt="@Model.ProjectName"
                 class="main-image" />
                        }

            <!-- 3D TASARIM GALERİ -->
            @if (Model.ProjectId == 3)
            {
                <div class="detail-gallery">
                    <img src="/images/portfolio/TapinakRender06.jpg" alt="Tapınak Render" />
                    <img src="/images/portfolio/MahzenOdaRender05.jpg" alt="Mahzen Oda Render" />
                    <img src="/images/portfolio/EvOdaRender01.jpg" alt="Ev Oda Render" />
                </div>
            }

            <!-- PIXEL ART – SADECE 6’LI GALERİ -->
            @if (Model.ProjectId == 5)
            {
                <div class="pixel-gallery">
                    <img src="/images/portfolio/kedi.png" alt="Pixel Art Kedi" />
                    <img src="/images/portfolio/fare.png" alt="Pixel Art Fare" />
                    <img src="/images/portfolio/Bulut.png" alt="Pixel Art Bulut" />

                    <img src="/images/portfolio/kapi.png" alt="Pixel Art Kapı" />
                    <img src="/images/portfolio/peynir.png" alt="Pixel Art Peynir" />
                    <img src="/images/portfolio/toprak_yapisi.png" alt="Pixel Art Toprak" />
                </div>
            }

            <!-- DEMO SADECE 2D OYUN -->
            @if (Model.ProjectId == 2)
            {
                <div class="image-actions">
                    <span class="demo-label">Oyunu denemek ister misin?</span>
                    <a href="https://etigong.itch.io/mouse-dash-cute-pixel-platformer-game"
                       target="_blank"
                       rel="noopener"
                       class="btn btn-outline-secondary">
                        Demo
                    </a>
                </div>
            }

        </div>

    </div>

</div>

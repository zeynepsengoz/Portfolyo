@using Portfolyo.Data
@model ProjectsTable

@{
    bool IsWebCategory(string? categoryName)
    {
        if (string.IsNullOrWhiteSpace(categoryName))
        {
            return false;
        }

        var normalized = categoryName.Trim().ToLowerInvariant()
            .Replace("ı", "i")
            .Replace("ş", "s")
            .Replace("ğ", "g")
            .Replace("ü", "u")
            .Replace("ö", "o")
            .Replace("ç", "c")
            .Replace(" ", "")
            .Replace("-", "")
            .Replace(".", "")
            .Replace("/", "")
            .Replace("&", "")
            .Replace("(", "")
            .Replace(")", "");

        return normalized.Contains("web");
    }

    string DisplayCategoryName(string? categoryName)
    {
        var normalized = categoryName?.Trim().ToLowerInvariant()
            .Replace("ı", "i")
            .Replace("ş", "s")
            .Replace("ğ", "g")
            .Replace("ü", "u")
            .Replace("ö", "o")
            .Replace("ç", "c")
            .Replace(" ", "")
            .Replace("-", "")
            .Replace(".", "")
            .Replace("/", "")
            .Replace("&", "")
            .Replace("(", "")
            .Replace(")", "");

        return normalized switch
        {
            "oyun" => "Game",
            "web" => "Web",
            "blender" => "Blender",
            "pixelart" => "Pixel Art",
            "characterdesign" => "Character Design",
            _ => categoryName ?? string.Empty
        };
    }

    var galleryImages = (Model.ProjectImages ?? new List<ProjectImageTable>())
        .OrderBy(x => x.SortOrder)
        .ThenBy(x => x.ProjectImageId)
        .ToList();
}

<div class="portfolio-detail-page">
    <a href="/Default/Index#portfolio" class="back-link">← Back to Portfolio</a>

    <div class="detail-layout">
        <div class="detail-info">
            <h1>@Model.ProjectName</h1>

            <span class="detail-meta">@Model.Title • @DisplayCategoryName(Model.Category?.CategoryName)</span>

            <p class="detail-desc">
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "A detailed description for this project has not been added yet."
                    : Model.Description)
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.GithubUrl))
            {
                <p class="mt-3 project-detail-link-wrap">
                    <a href="@Model.GithubUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary project-detail-link">
                        <i class="@(IsWebCategory(Model.Category?.CategoryName) ? "fab fa-github" : "fab fa-itch-io")"></i>
                        @(IsWebCategory(Model.Category?.CategoryName) ? " GitHub" : " itch.io")
                    </a>
                </p>
            }
        </div>

        <div class="detail-image">
            @if (galleryImages.Any())
            {
                <div class="detail-gallery">
                    @for (var i = 0; i < galleryImages.Count; i++)
                    {
                        var image = galleryImages[i];
                        <div class="portfolio-gallery-item">
                            <img src="@image.ImagePath"
                                 alt="@Model.ProjectName gallery image"
                                 class="js-lightbox-image"
                                 data-index="@i" />
                        </div>
                    }
                </div>
                <div id="detail-gallery-pagination" class="detail-gallery-pagination"></div>
            }
            else
            {
                <p class="text-muted">No detail images added yet.</p>
            }
        </div>
    </div>
</div>

<div id="portfolio-lightbox" class="portfolio-lightbox" hidden>
    <div class="portfolio-lightbox__backdrop" data-close="true"></div>
    <div class="portfolio-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Image gallery">
        <button type="button" class="portfolio-lightbox__close" aria-label="Close gallery">×</button>
        <button type="button" class="portfolio-lightbox__nav portfolio-lightbox__nav--prev" aria-label="Previous image">‹</button>
        <img id="portfolio-lightbox-image" src="" alt="Project gallery image" class="portfolio-lightbox__image" />
        <button type="button" class="portfolio-lightbox__nav portfolio-lightbox__nav--next" aria-label="Next image">›</button>
    </div>
</div>

<style>
    .portfolio-lightbox {
        position: fixed;
        inset: 0;
        z-index: 1200;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .portfolio-lightbox[hidden] {
        display: none;
    }

    .portfolio-lightbox__backdrop {
        position: absolute;
        inset: 0;
        background: rgba(9, 8, 18, 0.78);
        backdrop-filter: blur(3px);
    }

    .portfolio-lightbox__dialog {
        position: relative;
        width: min(92vw, 1100px);
        max-height: 90vh;
        border-radius: 18px;
        background: #120f1f;
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
        padding: 46px 54px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .portfolio-lightbox__image {
        max-width: 100%;
        max-height: calc(90vh - 92px);
        object-fit: contain;
        border-radius: 12px;
    }

    .portfolio-gallery-item {
        background: #fff;
        border-radius: 14px;
        border: 1px solid rgba(15, 23, 42, 0.08);
        min-height: 126px;
        padding: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .portfolio-gallery-item img {
        width: 100%;
        height: 100%;
        max-height: 110px;
        object-fit: contain;
        background: #fff;
    }

    .detail-gallery-pagination {
        margin-top: 14px;
        display: flex;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .detail-gallery-page-btn {
        border: 0;
        border-radius: 999px;
        min-width: 34px;
        height: 34px;
        padding: 0 12px;
        font-size: 13px;
        font-weight: 700;
        background: rgba(124, 58, 237, 0.14);
        color: #4b2a8d;
        cursor: pointer;
    }

    .detail-gallery-page-btn.active {
        background: linear-gradient(90deg, #7C3AED, #EC4899);
        color: #fff;
        box-shadow: 0 8px 20px rgba(124, 58, 237, 0.28);
    }

    .portfolio-lightbox__close {
        position: absolute;
        top: 12px;
        right: 14px;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        color: #fff;
        font-size: 25px;
        line-height: 1;
        cursor: pointer;
    }

    .portfolio-lightbox__nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 44px;
        height: 44px;
        border: 0;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        color: #fff;
        font-size: 28px;
        line-height: 1;
        cursor: pointer;
        display: grid;
        place-items: center;
    }

    .portfolio-lightbox__nav--prev {
        left: 10px;
    }

    .portfolio-lightbox__nav--next {
        right: 10px;
    }

    @@media (max-width: 768px) {
        .portfolio-lightbox__dialog {
            padding: 36px 40px;
            width: 95vw;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const images = Array.from(document.querySelectorAll(".js-lightbox-image"));
        const galleryItems = Array.from(document.querySelectorAll(".portfolio-gallery-item"));
        const pagination = document.getElementById("detail-gallery-pagination");
        const itemsPerPage = 6;
        let currentPage = 1;
        if (!images.length) {
            return;
        }

        const lightbox = document.getElementById("portfolio-lightbox");
        const backdrop = lightbox.querySelector(".portfolio-lightbox__backdrop");
        const lightboxImage = document.getElementById("portfolio-lightbox-image");
        const closeButton = lightbox.querySelector(".portfolio-lightbox__close");
        const prevButton = lightbox.querySelector(".portfolio-lightbox__nav--prev");
        const nextButton = lightbox.querySelector(".portfolio-lightbox__nav--next");
        let activeIndex = 0;

        function renderGalleryPagination(totalPages) {
            if (!pagination) {
                return;
            }

            pagination.innerHTML = "";
            if (totalPages <= 1) {
                return;
            }

            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.textContent = i.toString();
                btn.className = "detail-gallery-page-btn" + (i === currentPage ? " active" : "");
                btn.addEventListener("click", function () {
                    currentPage = i;
                    applyGalleryPage();
                });
                pagination.appendChild(btn);
            }
        }

        function applyGalleryPage() {
            if (!galleryItems.length) {
                return;
            }

            const totalPages = Math.max(1, Math.ceil(galleryItems.length / itemsPerPage));
            if (currentPage > totalPages) {
                currentPage = totalPages;
            }

            galleryItems.forEach(function (item, idx) {
                const page = Math.floor(idx / itemsPerPage) + 1;
                item.hidden = page !== currentPage;
            });

            renderGalleryPagination(totalPages);
        }

        function renderImage() {
            const current = images[activeIndex];
            lightboxImage.src = current.src;
            lightboxImage.alt = current.alt || "Project gallery image";
        }

        function openLightbox(index) {
            activeIndex = index;
            renderImage();
            lightbox.hidden = false;
            document.body.style.overflow = "hidden";
        }

        function closeLightbox() {
            lightbox.hidden = true;
            document.body.style.overflow = "";
        }

        function goPrev() {
            activeIndex = (activeIndex - 1 + images.length) % images.length;
            renderImage();
        }

        function goNext() {
            activeIndex = (activeIndex + 1) % images.length;
            renderImage();
        }

        images.forEach(function (img, index) {
            img.addEventListener("click", function () {
                openLightbox(index);
            });
        });

        backdrop.addEventListener("click", closeLightbox);
        closeButton.addEventListener("click", closeLightbox);
        prevButton.addEventListener("click", goPrev);
        nextButton.addEventListener("click", goNext);

        document.addEventListener("keydown", function (e) {
            if (lightbox.hidden) {
                return;
            }

            if (e.key === "Escape") {
                closeLightbox();
            } else if (e.key === "ArrowLeft") {
                goPrev();
            } else if (e.key === "ArrowRight") {
                goNext();
            }
        });

        applyGalleryPage();
    });
</script>

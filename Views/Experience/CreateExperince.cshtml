
@{
    ViewData["Title"] = "CreateExperince";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h1>Burası Deneyim Oluşturma Sayfası</h1>

<form method="post">
    <label>
        Deneyim Adı
    </label>
    <input type="text" class="form-control" name="ExperinceTitle"/>

<label>
    Level
</label>
<input type="text" class="form-control" name="ExperinceLevel" />

<label>
        Created Date
</label>
    <input type="text" class="form-control" name="ExperinceCreatedDate" />

    </br>

    <button type="submit" class="btn btn-success" >Ekle2</button>
</form>


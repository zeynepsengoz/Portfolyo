@model Portfolyo.Data.MessageTable

@{
    ViewData["Title"] = "Mesaj Detayı";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="min-h-screen bg-background-light flex justify-center py-20">
    <div class="w-full max-w-2xl bg-white rounded-2xl shadow-lg p-8">

        <h2 class="text-2xl font-bold text-slate-900 mb-1">
            Mesaj Detayı
        </h2>

        <p class="text-slate-500 mb-6">
            Kullanıcıdan gelen mesajın içeriği
        </p>

        <div class="space-y-4">

            <div>
                <span class="text-sm text-slate-500">Ad Soyad</span>
                <p class="text-base font-semibold text-slate-800">
                    @Model.Name
                </p>
            </div>

            <div>
                <span class="text-sm text-slate-500">E-posta</span>
                <p class="text-base font-semibold text-slate-800">
                    @Model.Email
                </p>
            </div>

            <div>
                <span class="text-sm text-slate-500">Gönderilme Tarihi</span>
                <p class="text-base font-semibold text-slate-800">
                    @Model.MessageDate.ToString("dd.MM.yyyy HH:mm")
                </p>
            </div>

            <div>
                <span class="text-sm text-slate-500">Mesaj</span>
                <div class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-4 text-slate-800">
                    @Model.MessageContent
                </div>
            </div>

        </div>

        <div class="mt-8 flex justify-end">
            <a href="/AdminMessages/Index"
               class="rounded-full bg-primary px-6 py-2.5 text-white font-semibold hover:brightness-110 transition">
                Mesajlara Dön
            </a>
        </div>

    </div>
</div>

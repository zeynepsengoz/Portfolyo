@model Portfolyo.Data.SkillTable

@{
    ViewData["Title"] = "Add New Skill";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="p-6 bg-background-light min-h-screen">
    <div class="max-w-2xl mx-auto">

        <a href="/SkillNew/SkillList" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-slate-700 mb-6">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Back to Skills
        </a>

        <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-8">
            <h1 class="text-2xl font-bold text-slate-900 mb-1">Add New Skill</h1>
            <p class="text-sm text-slate-500 mb-8">Create a new skill to showcase in your portfolio.</p>

            <form method="post">
                <div class="mb-6">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Skill Name</label>
                    <input type="text" name="Title" placeholder="Example: C#, React, UI Design" required
                           class="w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-primary/30 focus:outline-none">
                </div>

                <div class="mb-10">
                    <div class="flex items-center justify-between mb-2">
                        <label class="text-sm font-semibold text-slate-700">Skill Level (%)</label>
                        <span id="levelValue" class="text-sm font-semibold text-primary">50%</span>
                    </div>

                    <input type="range" name="Levels" min="0" max="100" value="50" class="w-full accent-primary"
                           oninput="document.getElementById('levelValue').innerText = this.value + '%'">

                    <div class="flex justify-between text-xs text-slate-400 mt-2">
                        <span>Beginner</span>
                        <span>Expert</span>
                    </div>
                </div>

                <button type="submit" class="w-full rounded-xl bg-primary hover:brightness-110 text-white py-4 font-semibold transition shadow-lg shadow-primary/30">
                    Save Skill
                </button>
            </form>
        </div>

        <div class="mt-4 flex items-center gap-2 text-xs text-slate-500">
            <span class="material-symbols-outlined text-sm">info</span>
            Once saved, this skill will automatically appear on the list page.
        </div>

    </div>
</div>

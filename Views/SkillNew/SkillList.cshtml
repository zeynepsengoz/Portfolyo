




@model List<Portfolyo.Data.SkillTable>

@{
    ViewData["Title"] = "SkillList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="p-6 bg-background-light min-h-screen">
    <div class="max-w-6xl mx-auto">

        <!-- HEADER -->
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">
                    Yetenek Yönetimi
                </h1>
                <p class="text-sm text-slate-500 mt-1">
                    Sistemde yer alan tüm yetenekleri buradan yönetebilirsiniz.
                </p>
            </div>

            <!-- YENİ YETENEK EKLE (Kaydet rengiyle aynı) -->
            <a href="/SkillNew/CreateSkill"
               class="inline-flex items-center gap-2 rounded-full
                      bg-blue-600 hover:bg-blue-700
                      px-5 py-2.5 text-sm font-semibold text-white
                      shadow-md transition">
                <span class="material-symbols-outlined text-base">add</span>
                Yeni Yetenek Ekle
            </a>
        </div>

        <!-- TABLE CARD -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">

            <table class="w-full text-left">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">#</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Yetenek</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Seviye</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase text-right">İşlemler</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-blue-50/40 transition">
                            <td class="px-6 py-4 text-sm text-slate-400">
                                #@item.SkilId
                            </td>

                            <td class="px-6 py-4 text-sm font-semibold text-slate-800">
                                @item.Title
                            </td>

                            <!-- SEVİYE -->
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3 max-w-xs">
                                    <div class="flex-1 h-2 rounded-full bg-slate-200 overflow-hidden">
                                        <!-- BAR (Kaydet rengi) -->
                                        <div class="h-full bg-blue-600 rounded-full"
                                             style="width:@item.Levels%">
                                        </div>
                                    </div>

                                    <!-- YÜZDE (Kaydet rengi) -->
                                    <span class="text-xs font-semibold text-blue-600">
                                        %@item.Levels
                                    </span>
                                </div>
                            </td>

                            <!-- ACTIONS -->
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2">

                                    <!-- EDIT -->
                                    <a href="/SkillNew/UpdateSkill/@item.SkilId"
                                       class="inline-flex items-center gap-1 rounded-full
                                                  bg-amber-50 text-amber-600
                                                  px-4 py-1.5 text-xs font-medium
                                                  hover:bg-amber-100 transition">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                        Düzenle
                                    </a>

                                    <!-- DELETE -->
                                    <a href="/SkillNew/DeleteSkill/@item.SkilId"
                                       onclick="return confirm('Silmek istediğine emin misin?')"
                                       class="inline-flex items-center gap-1 rounded-full
                                                  bg-red-50 text-red-600
                                                  px-4 py-1.5 text-xs font-medium
                                                  hover:bg-red-100 transition">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                        Sil
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

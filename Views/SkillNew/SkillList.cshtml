@model List<Portfolyo.Data.SkillTable>

@{
    ViewData["Title"] = "Skills";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="p-6 bg-background-light min-h-screen">
    <div class="max-w-6xl mx-auto">

        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Skill Management</h1>
                <p class="text-sm text-slate-500 mt-1">Manage all skills listed in the system from this page.</p>
            </div>

            <a href="/SkillNew/CreateSkill"
               class="inline-flex items-center gap-2 rounded-full bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-sm font-semibold text-white shadow-md transition">
                <span class="material-symbols-outlined text-base">add</span>
                Add New Skill
            </a>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">#</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Skill</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Level</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase text-right">Actions</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-blue-50/40 transition">
                            <td class="px-6 py-4 text-sm text-slate-400">#@item.SkilId</td>
                            <td class="px-6 py-4 text-sm font-semibold text-slate-800">@item.Title</td>

                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3 max-w-xs">
                                    <div class="flex-1 h-2 rounded-full bg-slate-200 overflow-hidden">
                                        <div class="h-full bg-blue-600 rounded-full" style="width:@item.Levels%"></div>
                                    </div>
                                    <span class="text-xs font-semibold text-blue-600">%@item.Levels</span>
                                </div>
                            </td>

                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <a href="/SkillNew/UpdateSkill/@item.SkilId"
                                       class="inline-flex items-center gap-1 rounded-full bg-amber-50 text-amber-600 px-4 py-1.5 text-xs font-medium hover:bg-amber-100 transition">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                        Edit
                                    </a>

                                    <a href="/SkillNew/DeleteSkill/@item.SkilId"
                                       onclick="return confirm('Are you sure you want to delete this skill?')"
                                       class="inline-flex items-center gap-1 rounded-full bg-red-50 text-red-600 px-4 py-1.5 text-xs font-medium hover:bg-red-100 transition">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

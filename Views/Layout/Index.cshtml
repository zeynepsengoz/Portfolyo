@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    @{
        var pageTitle = (ViewData["Title"] as string) ?? "Portfolyo";
        var fullTitle = pageTitle + " | Zeynep Şengöz";
        var siteDescription = "Zeynep Şengöz resmi portfolyo sitesi. Oyun geliştirme, 2D/3D tasarım ve proje çalışmaları.";
        var canonicalUrl = Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path;
        var imageUrl = Context.Request.Scheme + "://" + Context.Request.Host + Url.Content("~/images/portfolio/avatar.jpg");
    }
    <title>@fullTitle</title>
    <link rel="icon" type="image/svg+xml" href="@Url.Content("~/favicon.svg?v=3")" />
    <link rel="shortcut icon" type="image/svg+xml" href="@Url.Content("~/favicon.svg?v=3")" />

    <!-- Required Meta Tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="@siteDescription">
    <meta name="author" content="Zeynep Şengöz">
    <link rel="canonical" href="@canonicalUrl" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@siteDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@imageUrl" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@siteDescription" />
    <meta name="twitter:image" content="@imageUrl" />

    <!-- Base CSS -->
    <link rel="stylesheet" href="~/html/assets/vendor/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/html/assets/css/style.css">
    <link rel="stylesheet" href="~/html/assets/css/utilities.css">

    <!-- Libs CSS -->
    <link rel="stylesheet" href="~/html/assets/vendor/slick/slick.min.css" type="text/css">
    <link rel="stylesheet" href="~/html/assets/vendor/vegas/vegas.min.css" type="text/css">
    <link rel="stylesheet" href="~/html/assets/vendor/featherlight/featherlight.min.css" type="text/css">
    <link rel="stylesheet" href="~/html/assets/vendor/featherlight/featherlight.gallery.min.css" type="text/css">
    <link rel="stylesheet" href="~/html/assets/vendor/fontawesome/css/all.min.css" type="text/css">
    <link rel="stylesheet" href="~/html/assets/vendor/themify-icons/css/themify-icons.css" type="text/css">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

    <!-- CUSTOM CSS (EN SON, HER ŞEYİ EZER) -->
    <link rel="stylesheet" href="~/html/assets/css/custom.css">
</head>

<body>
    <div id="preloader" class="preloader">
        <div class="loader-status">
            <div class="spinner"></div>
        </div>
    </div>

    <div class="site-container">
        <div id="top"></div>

        <!-- Mobile logo -->
        <a href="#top" class="mobile-logo mobile-logo-light">
            <div class="overlay">
                <div class="overlay-inner bg-dark opacity-50"></div>
            </div>

            <span class="mobile-brand">
                <strong class="mobile-mark">ZŞ</strong>
                <small class="mobile-role">Game Developer</small>
            </span>
        </a>

        <!-- Navigation toggle -->
        <button type="button" id="navigation-toggle" class="nav-toggle nav-toggle-light">
            <div class="overlay">
                <div class="overlay-inner bg-dark opacity-50"></div>
            </div>
            <span></span>
        </button>

        <!-- Site header -->
        <header class="site-header bg-transparent">
            <div class="header-inner">
                <div class="overlay">
                    <div class="overlay-inner bg-dark opacity-85"></div>
                </div>

                
                    <!-- Logo -->
                <div class="header-brand">
                    <a href="#top" class="logo brand-row">
                        <span class="brand-mark">ZŞ</span> 


                        <span class="brand-title">
                            <span class="brand-game">Game</span>
                            <span class="brand-dev">Developer</span>
                        </span>
                    </a>
                </div>


                <div class="nav-divider mb-8"></div>

                <nav class="site-nav">
                    <ul id="navigation">

                        <li class="active">
                            <a asp-controller="Default" asp-action="Index">
                                <i class="fas fa-home"></i><span>Ana Sayfa</span>
                            </a>
                        </li>

                        <li>
                            <a href="#about" class="scrollto">
                                <i class="fas fa-user"></i><span>Hakkımda</span>
                            </a>
                        </li>

                        <li>
                            <a href="#skills" class="scrollto">
                                <i class="fas fa-bolt"></i><span>Yetenekler</span>
                            </a>
                        </li>

                        <li>
                            <a href="#portfolio" class="scrollto">
                                <i class="fas fa-briefcase"></i><span>Portfolyo</span>
                            </a>
                        </li>

                        <li>
                            <a href="#contact" class="scrollto">
                                <i class="fas fa-envelope"></i><span>İletişim</span>
                            </a>
                        </li>
                    </ul>


                </nav>

                <div class="nav-divider my-8"></div>

                <!-- Social icons -->
                <nav class="sidebar-social">
                    <div class="social-bubbles">
                        <a class="social-bubble" href="https://github.com/zeynepsengoz" target="_blank" title="GitHub">
                            <i class="fab fa-github"></i>
                        </a>
                        <a class="social-bubble" href="https://etigong.itch.io/" target="_blank" title="itch.io">
                            <i class="fab fa-itch-io"></i>
                        </a>
                        <a class="social-bubble" href="https://www.linkedin.com/in/zeynep-%C5%9Feng%C3%B6z-b9148a32b/" target="_blank" title="LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                    </div>
                </nav>



            </div>
        </header>

        <!-- Header overlay -->
        <div class="header-overlay">
            <div class="overlay-inner bg-dark opacity-80"></div>
        </div>

        <!-- Back to top button -->
        <button type="button" id="backtotop" class="btn btn-primary btn-icon">
            <span class="btn-icon-inner fas fa-angle-up"></span>
        </button>

        <!-- Global cover background -->
        <div class="global-cover-bg">
            <div class="overlay-inner bg-image-holder bg-cover">
                <img src="~/html/demo/images/image-1.jpg" alt="background">
            </div>
        </div>

        <!-- Page wrapper -->
        <div class="page-wrapper">
            <div class="page-content">
                @RenderBody()
            </div><!-- end .page-content -->
        </div><!-- end .page-wrapper -->
    </div>

    <!-- Libs JS (YOLLARI DÜZELTİLDİ) -->
    <script src="~/html/assets/vendor/jquery/dist/jquery.min.js"></script>
    <script src="~/html/assets/vendor/popper.js/dist/popper.min.js"></script>
    <script src="~/html/assets/vendor/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/html/assets/vendor/jquery.easing/jquery.easing.min.js"></script>
    <script src="~/html/assets/vendor/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/html/assets/vendor/jquery-form/dist/jquery.form.min.js"></script>
    <script src="~/html/assets/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
    <script src="~/html/assets/vendor/isotope/dist/isotope.pkgd.min.js"></script>
    <script src="~/html/assets/vendor/featherlight/jquery.detect_swipe.js"></script>
    <script src="~/html/assets/vendor/featherlight/featherlight.min.js"></script>
    <script src="~/html/assets/vendor/featherlight/featherlight.gallery.min.js"></script>
    <script src="~/html/assets/vendor/slick/slick.min.js"></script>
    <script src="~/html/assets/vendor/vegas/vegas.min.js"></script>
    <script src="~/html/assets/vendor/typed.js/typed.min.js"></script>
    <script src="~/html/assets/vendor/granim.js/dist/granim.min.js"></script>

    <!-- Theme JS -->
    <script src="~/html/assets/js/main.js"></script>
</body>
</html>

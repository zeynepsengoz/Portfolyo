
 
@model List<Portfolyo.Data.SkillTable>

<section id="skills" style="padding:10px 0 40px;">

    <h2 style="text-align:center; margin-bottom:24px;">
        Yeteneklerim
    </h2>

    <div style="
        max-width:900px;
        margin:0 auto;
        display:grid;
        grid-template-columns:repeat(2, 1fr);
        gap:32px;
    ">

        @foreach (var item in Model)
        {
            <div>

                <div style="
                            display:flex;
                            justify-content:space-between;
                            margin-bottom:6px;
                            font-weight:600;
                        ">
                    <span>@item.Title</span>
                    <span>% @item.Levels</span>
                </div>

                <div style="
                            width:100%;
                            height:10px;
                            background:#e5e7eb;
                            border-radius:10px;
                        ">
                    <div style="
                                height:10px;
                                width:@(item.Levels)%;
                                background:#2563eb;
                                border-radius:10px;
                            ">
                    </div>
                </div>

            </div>
        }

    </div>

</section>



@model AboutViewModel

<section id="about" class="about-section">
    <div class="about-wrapper">

        <h2 class="about-title">Hakkımda</h2>

        <div class="about-grid">

            <!-- SOL: PARAGRAF -->
            <div class="about-left">
                <p>
                    @Model.Info?.LongDescription
                </p>
            </div>

            <!-- SAĞ: BİLGİLER -->
            <div class="about-right">

                <ul class="about-info">
                    <li><strong>Yaş:</strong> @Model.Info?.Age</li>
                    <li>
                        <strong>E-posta:</strong>
                        <a href="mailto:@Model.Info?.Email">
                            @Model.Info?.Email
                        </a>
                    </li>
                    <li>
                        <strong>İlgi Alanları:</strong>
                        @Model.Info?.Interests
                    </li>
                </ul>

                <div class="about-education">
                    <h3>Eğitim</h3>

                    @foreach (var edu in Model.Educations)
                    {
                        <div class="edu-item">
                            <strong>@edu.SchoolName</strong>
                            <div>@edu.Department</div>
                            <small>
                                @edu.StartYear –
                                @(edu.EndYear.HasValue? edu.EndYear.ToString() : "Devam Ediyor")
                            </small>

                        </div>
                    }
                </div>

            </div>

        </div>
    </div>
</section>

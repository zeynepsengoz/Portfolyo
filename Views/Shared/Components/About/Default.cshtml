@model AboutViewModel

<section id="about" class="about-section">
    <div class="about-wrapper">
        <h2 class="about-title">About</h2>

        <div class="about-grid">
            <div class="about-left">
                <p>@Model.Info?.LongDescription</p>
            </div>

            <div class="about-right">
                <ul class="about-info">
                    <li><strong>Age:</strong> @Model.Info?.Age</li>
                    <li>
                        <strong>Email:</strong>
                        <a href="mailto:@Model.Info?.Email">@Model.Info?.Email</a>
                    </li>
                    <li><strong>Interests:</strong> @Model.Info?.Interests</li>
                </ul>

                <div class="about-education">
                    <h3>Education</h3>

                    @foreach (var edu in Model.Educations)
                    {
                        <div class="edu-item">
                            <strong>@edu.SchoolName</strong>
                            <div>@edu.Department</div>
                            <small>@edu.StartYear – @(edu.EndYear.HasValue ? edu.EndYear.ToString() : "Ongoing")</small>
                        </div>
                    }
                </div>

            </div>

        </div>
    </div>
</section>

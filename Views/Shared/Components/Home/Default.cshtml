@using Portfolyo.Data
@model AboutMeTable

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var heroDescription = !string.IsNullOrWhiteSpace(Model?.ShortDescription)
        ? Model.ShortDescription
        : Model?.Description;
}

<section class="zh-home">
    <div class="page-container">
        <div class="zh-home__wrap">

            <div class="zh-home__left">
                <h1 class="zh-home__name">@Model?.NameSurname</h1>

                <div class="zh-home__title">@Model?.JobTitle</div>
                <br />
                @if (!string.IsNullOrEmpty(heroDescription))
                {
                    <p class="zh-home__desc">@heroDescription</p>
                }
            </div>

            <div class="zh-home__right">
                <img class="zh-home__avatar"
                     src="@(string.IsNullOrEmpty(Model?.ImagePath)
                                ? "/images/placeholder.png"
                                : Model.ImagePath)" />
            </div>

        </div>
    </div>
</section>

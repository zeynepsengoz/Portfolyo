@{
    ViewData["Title"] = "Sertifikalar";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="p-8 bg-[#f6f8fc] min-h-screen">
    <div class="max-w-6xl mx-auto">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Sertifikalar</h1>
                <p class="mt-2 text-sm text-slate-500">
                    Aldığın sertifikaları burada yönetebilirsin.
                </p>
            </div>

            <span class="rounded-full bg-primary/10 px-4 py-2 text-xs font-extrabold text-primary border border-primary/20">
                Şimdilik Pasif
            </span>
        </div>

        <div class="mt-6 bg-white rounded-2xl p-10 shadow-sm border border-slate-200">
            <div class="flex flex-col items-center text-center gap-3">
                <div class="h-14 w-14 rounded-2xl grid place-items-center bg-primary/10 text-primary border border-primary/20">
                    <span class="material-symbols-outlined icon-fill text-[28px]">workspace_premium</span>
                </div>

                <h2 class="text-lg font-extrabold text-slate-900">Henüz sertifika eklenmedi</h2>
                <p class="max-w-md text-sm text-slate-500">
                    Şu an bu bölümü kullanmıyorsun. İleride aktif edip sertifikalarını ekleyebilirsin.
                </p>

                <div class="mt-4 flex flex-wrap gap-3 justify-center">
                    <a href="/Dashboard/Index"
                       class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-3 text-sm font-bold text-white shadow-lg shadow-primary/20 hover:brightness-95">
                        <span class="material-symbols-outlined icon-fill text-[20px]">dashboard</span>
                        Dashboard’a dön
                    </a>

                    <button type="button" disabled
                            class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-5 py-3 text-sm font-extrabold text-slate-400 border border-slate-200 cursor-not-allowed">
                        <span class="material-symbols-outlined text-[20px]">add</span>
                        Ekle (Yakında)
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

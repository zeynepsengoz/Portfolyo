@model List<Portfolyo.Data.ServicesTable>

@{
    ViewData["Title"] = "Experience Items";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="p-6 bg-background-light min-h-screen">
    <div class="max-w-6xl mx-auto">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Experience Items</h1>
                <p class="text-sm text-slate-500 mt-1">Manage service/experience cards displayed on the public page.</p>
            </div>
            <a href="/Services/CreateServices" class="inline-flex items-center gap-2 rounded-full bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-sm font-semibold text-white shadow-md transition">
                <span class="material-symbols-outlined text-base">add</span>
                Add Item
            </a>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Id</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Title</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Description</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase">Icon</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-blue-50/40 transition">
                            <td class="px-6 py-4">@item.ExperinceId</td>
                            <td class="px-6 py-4 font-semibold">@item.Title</td>
                            <td class="px-6 py-4 text-slate-600">@item.Description</td>
                            <td class="px-6 py-4"><i class="@item.Icon"></i></td>
                            <td class="px-6 py-4 text-right">
                                <a href="/Services/UpdateServices/@item.ExperinceId" class="inline-flex items-center gap-1 rounded-full bg-amber-50 text-amber-600 px-4 py-1.5 text-xs font-medium hover:bg-amber-100 transition">Edit</a>
                                <a href="/Services/DeleteServices/@item.ExperinceId" class="inline-flex items-center gap-1 rounded-full bg-red-50 text-red-600 px-4 py-1.5 text-xs font-medium hover:bg-red-100 transition">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

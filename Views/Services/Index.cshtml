@model List<Portfolyo.Data.ServicesTable>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h1>Burası Deneyim Sayfası</h1>

<div class="container">
    <table class="table table - bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th>
                <th>Icon</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ExperinceId</td>
                    <td>@item.Title</td>
                    <td>@item.Description</td>
                    <td><i class=@item.Icon></i></td>
                    <td><a href ="/Services/UpdateServices/@item.ExperinceId" class="btn btn -success">/a></td>
                    <td><a href ="/Services/DeleteServices/@item.ExperinceId" class="btn btn -success">/a></td>
                        
                    
                </tr>
            }

        </tbody>
    </table>
</div>

